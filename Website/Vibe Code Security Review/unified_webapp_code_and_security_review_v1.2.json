    "possible_user_actions_for_har": [
      {
        "action_name": "anonymous_browse_homepage",
        "required": true,
        "description": "Load homepage and key public pages.",
        "expected_security_properties": [
          "https_only",
          "no_sensitive_data_exposed",
          "security_headers_present_if_applicable"
        ]
      },
      {
        "action_name": "login",
        "required": false,
        "description": "Authenticate with a normal user account.",
        "expected_security_properties": [
          "secure_transport",
          "no_credentials_logged_or_echoed",
          "session_or_token_handling_secure",
          "no_verbose_auth_errors"
        ]
      },
      {
        "action_name": "logout",
        "required": false,
        "description": "Terminate session.",
        "expected_security_properties": [
          "session_invalidated",
          "no_residual_access_after_logout"
        ]
      },
      {
        "action_name": "form_submission",
        "required": false,
        "description": "Submit any public or authenticated form.",
        "expected_security_properties": [
          "server_side_validation",
          "csrf_protection_if_applicable",
          "no_sensitive_response_leakage"
        ]
      },
      {
        "action_name": "failed_login",
        "required": false,
        "description": "Attempt invalid authentication.",
        "expected_security_properties": [
          "sanitized_error_messages",
          "no_account_enumeration",
          "rate_limiting_or_abuse_controls_if_applicable"
        ]
      },
      {
        "action_name": "authenticated_navigation",
        "required": false,
        "description": "Browse authenticated pages and invoke main API actions.",
        "expected_security_properties": [
          "authorization_enforced",
          "no_idor_behavior",
          "no_sensitive_data_overexposure"
        ]
      },
      {
        "action_name": "admin_action",
        "required": false,
        "description": "Perform an admin-only action if the app has administrative features.",
        "expected_security_properties": [
          "strong_server_side_authorization",
          "no_client_side_only_trust",
          "auditability_if_applicable"
        ]
      },
      {
        "action_name": "file_upload",
        "required": false,
        "description": "Upload a supported file if upload functionality exists.",
        "expected_security_properties": [
          "file_type_validation",
          "upload_restrictions",
          "no_dangerous_execution_or_path_traversal"
        ]
      }
    ]
  },
