      "review_code_first": true,
      "review_security_after_code_quality": true,
      "require_per_file_code_review": true,
      "do_not_ignore_generated_or_config_files_if_security_relevant": true,
      "focus_on_maintainability_and_correctness_before_declaring_security_confidence": true,
      "code_review_must_not_change_security_severity_directly": true
