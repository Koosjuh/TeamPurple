{
  "meta": {
    "schema_name": "Unified-WebApp-Code-and-Security-Review",
    "schema_version": "1.2",
    "assessment_target": {
      "project_name": "NAME_HERE",
      "project_type": "web_app",
      "environment": "production",
      "internet_exposed": true,
      "contains_sensitive_data": false,
      "authentication_required": true,
      "notes": ""
    },
    "frameworks": [
      "NIST SP 800-218 SSDF",
      "OWASP ASVS",
      "OWASP Top 10",
      "OWASP Web Security Testing Guide",
      "Google Engineering Practices - Code Review"
    ],
    "status_enum": [
      "unknown",
      "implemented",
      "missing",
      "not_applicable",
      "critical_mistake"
    ],
    "severity_enum": [
      "informational",
      "low",
      "medium",
      "high",
      "critical"
    ],
    "confidence_enum": [
      "low",
      "medium",
      "high"
    ],
    "status_rules": {
      "unknown": "The control or review item has not yet been evaluated or available evidence is insufficient to determine a final status.",
      "implemented": "The control exists and is correctly implemented based on available evidence.",
      "missing": "The control is expected for this project but is absent or insufficient.",
      "not_applicable": "The control does not apply to this architecture or feature set and the reason must be explicit.",
      "critical_mistake": "The control is implemented in a dangerously insecure way or a severe design flaw exists that should be fixed immediately."
    },
    "review_order": [
      "repository_inventory_and_coverage",
      "code_review_per_file",
      "security_review_per_file",
      "har_review_per_action",
      "correlation_between_code_har_and_declared_controls",
      "final_risk_rating_and_remediation_order"
    ],
    "review_instructions": {
      "goal": "Assess the project against code quality, maintainability, security, and runtime behavior requirements using repo files, HAR evidence, and declared architecture.",
      "expected_behavior": "Mark every control with one status only and provide evidence-based reasoning.",
      "strict_mode": true,
      "zero_trust": true,
      "do_not_assume_secure_defaults": true,
      "do_not_mark_implemented_without_evidence": true,
      "do_not_mark_not_applicable_without_explicit_reason": true,
      "report_unknown_when_evidence_is_insufficient": true,
      "review_every_file_or_account_for_it_explicitly": true,
      "repo_review_must_precede_security_review": true,
      "har_review_must_validate_runtime_claims": true
    }
  },
