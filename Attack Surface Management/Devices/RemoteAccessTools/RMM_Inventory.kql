// Remote Access / RMM inventory and activity report
// Run in Microsoft Defender XDR Advanced Hunting.
//
// InstalledDevices:
//   Devices where matching software is currently present in DeviceTvmSoftwareInventory.
//
// DevicesWithObservedActivity:
//   Devices where a matching process was observed during the configured Lookback.
//
// DevicesWithInteractiveOrSessionActivity:
//   Devices where a process classified as Interactive, Viewer,
//   TechnicianConsole, or SessionComponent was observed.
//
// DetectedSoftwareNames:
//   Actual DeviceTvmSoftwareInventory software names that matched.
//
// ObservedProcesses:
//   Actual process filenames observed by Defender.
//
// MatchedSoftwareIndicators / MatchedProcessIndicators:
//   Catalogue values responsible for the match.
//
// Persistent Agent/Service activity does not necessarily indicate
// that an interactive remote-control session occurred.
let Lookback = 30d;
let IncludeSupplementalIndicators = false; // Set to true to also include disabled supplemental indicators that are not yet sufficiently vendor-verified.
let RemoteAccessProducts =
    externaldata(
        ProductId:string,
        Vendor:string,
        Product:string,
        Type:string,
        OfficialURL:string,
        LastVerified:string,
        Notes:string
    )
    [
        @"https://raw.githubusercontent.com/Koosjuh/TeamPurple/main/Attack%20Surface%20Management/Devices/RemoteAccessTools/Catalogue/RemoteAccessProducts.csv"
    ]
    with (
        format="csv",
        ignoreFirstRecord=true
    );
let RemoteAccessIndicatorsRaw =
    externaldata(
        ProductId:string,
        Platform:string,
        IndicatorType:string,
        IndicatorValue:string,
        MatchType:string,
        ActivityRole:string,
        PathPattern:string,
        CompanyPattern:string,
        Enabled:bool,
        Confidence:string,
        SourceURL:string,
        LastVerified:string,
        Notes:string
    )
    [
        @"https://raw.githubusercontent.com/Koosjuh/TeamPurple/main/Attack%20Surface%20Management/Devices/RemoteAccessTools/Catalogue/RemoteAccessIndicators.csv"
    ]
    with (
        format="csv",
        ignoreFirstRecord=true
    );
let ActiveIndicators =
    RemoteAccessIndicatorsRaw
    | where Enabled == true
        or (IncludeSupplementalIndicators and Confidence == "Supplemental")
    | where Platform in ("Windows", "All")
    | project
        ProductId,
        IndicatorType,
        IndicatorValue,
        MatchType,
        ActivityRole,
        PathPattern,
        CompanyPattern;
// -----------------------------------------------------------------------------
// SOFTWARE INVENTORY
// -----------------------------------------------------------------------------
let WindowsSoftwareInventory =
    materialize(
        DeviceTvmSoftwareInventory
        | where OSPlatform startswith_cs "Windows"
        | project
            DeviceId,
            SoftwareName
    );
let SoftwareIndicatorsExact =
    ActiveIndicators
    | where IndicatorType == "SoftwareName"
    | where MatchType == "equals"
    | project
        ProductId,
        IndicatorValue;
let SoftwareIndicatorsPattern =
    ActiveIndicators
    | where IndicatorType == "SoftwareName"
    | where MatchType in ("contains", "startswith")
    | project
        ProductId,
        IndicatorValue,
        MatchType;
let SoftwareExactNames =
    SoftwareIndicatorsExact
    | distinct IndicatorValue;
let InstalledExact =
    SoftwareIndicatorsExact
    | extend SoftwareNameKey = tolower(IndicatorValue)
    | join kind=inner (
        WindowsSoftwareInventory
        | where SoftwareName in~ (SoftwareExactNames)
        | extend SoftwareNameKey = tolower(SoftwareName)
    ) on SoftwareNameKey
    | project
        ProductId,
        DeviceId,
        SoftwareName,
        MatchedIndicator = IndicatorValue;
let InstalledPattern =
    SoftwareIndicatorsPattern
    | extend JoinKey = 1
    | join kind=inner (
        WindowsSoftwareInventory
        | extend JoinKey = 1
    ) on JoinKey
    | where
        (MatchType == "contains" and SoftwareName contains IndicatorValue)
        or
        (MatchType == "startswith" and SoftwareName startswith IndicatorValue)
    | project
        ProductId,
        DeviceId,
        SoftwareName,
        MatchedIndicator = IndicatorValue;
let InstalledMatches =
    union InstalledExact, InstalledPattern;
let Installed =
    InstalledMatches
    | summarize
        InstalledDevices = dcount(DeviceId),
        DetectedSoftwareNames = make_set(SoftwareName, 50),
        MatchedSoftwareIndicators = make_set(MatchedIndicator, 50)
      by ProductId;
let ProcessIndicatorsExact =
    ActiveIndicators
    | where IndicatorType == "ProcessName"
    | where MatchType == "equals"
    | project
        ProductId,
        IndicatorValue,
        ActivityRole,
        PathPattern,
        CompanyPattern;
let ExactProcessNames =
    ProcessIndicatorsExact
    | distinct IndicatorValue;
let CandidateExactProcessEvents =
    materialize(
        DeviceProcessEvents
        | where Timestamp >= ago(Lookback)
        | where FileName in~ (ExactProcessNames)
        | project
            Timestamp,
            DeviceId,
            FileName,
            FolderPath,
            ProcessVersionInfoCompanyName
    );
let ActivityExact =
    ProcessIndicatorsExact
    | extend FileNameKey = tolower(IndicatorValue)
    | join kind=inner (
        CandidateExactProcessEvents
        | extend FileNameKey = tolower(FileName)
    ) on FileNameKey
    | where
        isempty(PathPattern)
        or FolderPath contains PathPattern
    | where
        isempty(CompanyPattern)
        or ProcessVersionInfoCompanyName contains CompanyPattern
    | project
        Timestamp,
        ProductId,
        DeviceId,
        FileName,
        ActivityRole,
        MatchedIndicator = IndicatorValue;
// -----------------------------------------------------------------------------
// PROCESS INDICATORS - STARTSWITH / CONTAINS
// -----------------------------------------------------------------------------
//
// Pattern matching is handled generically for every product.
//
// A search token is derived from IndicatorValue and used to reduce the
// DeviceProcessEvents dataset before applying startswith/contains.
let ProcessIndicatorsPattern =
    ActiveIndicators
    | where IndicatorType == "ProcessName"
    | where MatchType in ("startswith", "contains")
    | extend PrefilterToken = extract(@"[A-Za-z0-9]{3,}", 0, IndicatorValue)
    | where isnotempty(PrefilterToken)
    | project
        ProductId,
        IndicatorValue,
        MatchType,
        ActivityRole,
        PathPattern,
        CompanyPattern,
        PrefilterToken;
let ProcessPatternTerms =
    ProcessIndicatorsPattern
    | distinct PrefilterToken;
let CandidatePatternProcessEvents =
    materialize(
        DeviceProcessEvents
        | where Timestamp >= ago(Lookback)
        | where FileName has_any (ProcessPatternTerms)
        | project
            Timestamp,
            DeviceId,
            FileName,
            FolderPath,
            ProcessVersionInfoCompanyName
    );
let ActivityPattern =
    ProcessIndicatorsPattern
    | extend JoinKey = 1
    | join kind=inner (
        CandidatePatternProcessEvents
        | extend JoinKey = 1
    ) on JoinKey
    | where
        (MatchType == "startswith" and FileName startswith IndicatorValue)
        or
        (MatchType == "contains" and FileName contains IndicatorValue)
    | where
        isempty(PathPattern)
        or FolderPath contains PathPattern
    | where
        isempty(CompanyPattern)
        or ProcessVersionInfoCompanyName contains CompanyPattern
    | project
        Timestamp,
        ProductId,
        DeviceId,
        FileName,
        ActivityRole,
        MatchedIndicator = IndicatorValue;
let ActivityMatches =
    materialize(
        union ActivityExact, ActivityPattern
    );
let Activity =
    ActivityMatches
    | summarize
        DevicesWithObservedActivity = dcount(DeviceId),
        LastObserved = max(Timestamp),
        ObservedProcesses = make_set(FileName, 100),
        MatchedProcessIndicators = make_set(MatchedIndicator, 100),
        ObservedRoles = make_set(ActivityRole, 20)
      by ProductId;
let InteractiveActivity =
    ActivityMatches
    | where ActivityRole in (
        "Interactive",
        "Viewer",
        "TechnicianConsole",
        "SessionComponent"
    )
    | summarize
        DevicesWithInteractiveOrSessionActivity = dcount(DeviceId),
        LastInteractiveOrSessionObserved = max(Timestamp),
        InteractiveOrSessionProcesses = make_set(FileName, 100)
      by ProductId;
// -----------------------------------------------------------------------------
// FINAL REPORT
// -----------------------------------------------------------------------------
RemoteAccessProducts
| project
    ProductId,
    Vendor,
    Product,
    Type
| join kind=leftouter Installed on ProductId
| join kind=leftouter Activity on ProductId
| join kind=leftouter InteractiveActivity on ProductId
| extend
    InstalledDevices = coalesce(InstalledDevices, 0),
    DevicesWithObservedActivity = coalesce(DevicesWithObservedActivity, 0),
    DevicesWithInteractiveOrSessionActivity = coalesce(DevicesWithInteractiveOrSessionActivity, 0),
    ActivityLookback = tostring(Lookback)
| where
    InstalledDevices > 0
    or DevicesWithObservedActivity > 0
| project
    Vendor,
    Product,
    Type,
    InstalledDevices,
    DetectedSoftwareNames,
    MatchedSoftwareIndicators,
    DevicesWithObservedActivity,
    ObservedProcesses,
    MatchedProcessIndicators,
    ObservedRoles,
    LastObserved,
    DevicesWithInteractiveOrSessionActivity,
    InteractiveOrSessionProcesses,
    LastInteractiveOrSessionObserved
| order by
    InstalledDevices desc,
    DevicesWithObservedActivity desc,
    Product asc
