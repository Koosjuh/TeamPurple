// Remote Access / RMM inventory and activity report
// Run in Microsoft Defender XDR Advanced Hunting.
let Lookback = 2d;
let IncludeSupplementalIndicators = false; // Set to true to also include disabled supplemental indicators that are not yet sufficiently vendor-verified.
let RemoteAccessProducts = externaldata(
    ProductId:string,
    Vendor:string,
    Product:string,
    Type:string,
    OfficialURL:string,
    LastVerified:string,
    Notes:string
)
[
    @"https://raw.githubusercontent.com/Koosjuh/TeamPurple/main/Attack%20Surface%20Management/Devices/RemoteAccessTools/Catalogue/RemoteAccessProducts.csv"
]
with (
    format="csv",
    ignoreFirstRecord=true
);
let RemoteAccessIndicators = externaldata(
    ProductId:string,
    Platform:string,
    IndicatorType:string,
    IndicatorValue:string,
    MatchType:string,
    ActivityRole:string,
    PathPattern:string,
    CompanyPattern:string,
    Enabled:bool,
    Confidence:string,
    SourceURL:string,
    LastVerified:string,
    Notes:string
)
[
    @"https://raw.githubusercontent.com/Koosjuh/TeamPurple/main/Attack%20Surface%20Management/Devices/RemoteAccessTools/Catalogue/RemoteAccessIndicators.csv"
]
with (
    format="csv",
    ignoreFirstRecord=true
)
| where Enabled == true or IncludeSupplementalIndicators
| where Platform in~ ("Windows", "All");
// -----------------------------------------------------------------------------
// Installed software
// -----------------------------------------------------------------------------
let SoftwareIndicatorsExact =
    RemoteAccessIndicators
    | where IndicatorType =~ "SoftwareName"
    | where MatchType =~ "equals"
    | extend SoftwareNameLower = tolower(IndicatorValue)
    | project
        ProductId,
        SoftwareNameLower,
        Confidence;
let SoftwareIndicatorsPattern =
    RemoteAccessIndicators
    | where IndicatorType =~ "SoftwareName"
    | where MatchType !~ "equals"
    | extend
        IndicatorLower = tolower(IndicatorValue),
        JoinKey = 1
    | project
        ProductId,
        IndicatorLower,
        MatchType,
        Confidence,
        JoinKey;
let InstalledExact =
    DeviceTvmSoftwareInventory
    | where OSPlatform startswith "Windows"
    | extend SoftwareNameLower = tolower(SoftwareName)
    | join kind=inner SoftwareIndicatorsExact on SoftwareNameLower
    | project
        ProductId,
        DeviceId,
        DeviceName,
        SoftwareVendor,
        SoftwareName,
        SoftwareVersion,
        Confidence;
let InstalledPattern =
    DeviceTvmSoftwareInventory
    | where OSPlatform startswith "Windows"
    | extend
        SoftwareNameLower = tolower(SoftwareName),
        JoinKey = 1
    | join kind=inner SoftwareIndicatorsPattern on JoinKey
    | where
        (MatchType =~ "contains" and SoftwareNameLower contains IndicatorLower)
        or
        (MatchType =~ "startswith" and SoftwareNameLower startswith IndicatorLower)
    | project
        ProductId,
        DeviceId,
        DeviceName,
        SoftwareVendor,
        SoftwareName,
        SoftwareVersion,
        Confidence;
let InstalledMatches =
    union InstalledExact, InstalledPattern;
let Installed =
    InstalledMatches
    | summarize
        InstalledDevices = dcount(DeviceId),
        DetectedSoftwareNames = make_set(SoftwareName, 25),
        DetectedSoftwareVersions = make_set(SoftwareVersion, 25)
      by ProductId;
// -----------------------------------------------------------------------------
// Process activity
// -----------------------------------------------------------------------------
let ProcessIndicatorsExact =
    RemoteAccessIndicators
    | where IndicatorType =~ "ProcessName"
    | where MatchType =~ "equals"
    | extend
        FileNameLower = tolower(IndicatorValue),
        PathLower = tolower(PathPattern),
        CompanyLower = tolower(CompanyPattern)
    | project
        ProductId,
        FileNameLower,
        ActivityRole,
        PathLower,
        CompanyLower,
        Confidence;
let ProcessIndicatorsPattern =
    RemoteAccessIndicators
    | where IndicatorType =~ "ProcessName"
    | where MatchType !~ "equals"
    | extend
        IndicatorLower = tolower(IndicatorValue),
        PathLower = tolower(PathPattern),
        CompanyLower = tolower(CompanyPattern),
        JoinKey = 1
    | project
        ProductId,
        IndicatorLower,
        MatchType,
        ActivityRole,
        PathLower,
        CompanyLower,
        Confidence,
        JoinKey;
let ActivityExact =
    DeviceProcessEvents
    | where Timestamp >= ago(Lookback)
    | extend
        FileNameLower = tolower(FileName),
        FolderPathLower = tolower(FolderPath),
        CompanyNameLower = tolower(ProcessVersionInfoCompanyName)
    | join kind=inner ProcessIndicatorsExact on FileNameLower
    | where isempty(PathLower) or FolderPathLower contains PathLower
    | where isempty(CompanyLower) or CompanyNameLower contains CompanyLower
    | project
        Timestamp,
        ProductId,
        DeviceId,
        DeviceName,
        FileName,
        FolderPath,
        ProcessVersionInfoCompanyName,
        ProcessVersionInfoProductName,
        AccountUpn,
        ActivityRole,
        Confidence;
let ActivityPattern =
    DeviceProcessEvents
    | where Timestamp >= ago(Lookback)
    | extend
        FileNameLower = tolower(FileName),
        FolderPathLower = tolower(FolderPath),
        CompanyNameLower = tolower(ProcessVersionInfoCompanyName),
        JoinKey = 1
    | join kind=inner ProcessIndicatorsPattern on JoinKey
    | where
        (MatchType =~ "contains" and FileNameLower contains IndicatorLower)
        or
        (MatchType =~ "startswith" and FileNameLower startswith IndicatorLower)
    | where isempty(PathLower) or FolderPathLower contains PathLower
    | where isempty(CompanyLower) or CompanyNameLower contains CompanyLower
    | project
        Timestamp,
        ProductId,
        DeviceId,
        DeviceName,
        FileName,
        FolderPath,
        ProcessVersionInfoCompanyName,
        ProcessVersionInfoProductName,
        AccountUpn,
        ActivityRole,
        Confidence;
let ActivityMatches =
    union ActivityExact, ActivityPattern;
// Any matching process means a product component executed.
// Persistent services/agents do not necessarily indicate an interactive session.
let Activity =
    ActivityMatches
    | summarize
        ActiveDevices30d = dcount(DeviceId),
        LastObserved = max(Timestamp),
        ObservedProcesses = make_set(FileName, 50),
        ObservedRoles = make_set(ActivityRole, 20)
      by ProductId;
// Stronger evidence of actual interactive/session activity.
let InteractiveActivity =
    ActivityMatches
    | where ActivityRole in~ (
        "Interactive",
        "Viewer",
        "TechnicianConsole",
        "SessionComponent"
    )
    | summarize
        InteractiveOrSessionDevices30d = dcount(DeviceId),
        LastInteractiveOrSessionObserved = max(Timestamp)
      by ProductId;
// Include products that are installed OR observed executing.
// This also catches portable tools that are absent from installed-software inventory.
let DetectedProductIds =
    union
        (Installed | project ProductId),
        (Activity | project ProductId)
    | distinct ProductId;
DetectedProductIds
| join kind=leftouter RemoteAccessProducts on ProductId
| join kind=leftouter Installed on ProductId
| join kind=leftouter Activity on ProductId
| join kind=leftouter InteractiveActivity on ProductId
| extend
    InstalledDevices = coalesce(InstalledDevices, 0),
    ActiveDevices30d = coalesce(ActiveDevices30d, 0),
    InteractiveOrSessionDevices30d = coalesce(InteractiveOrSessionDevices30d, 0)
| project
    Vendor,
    Product,
    Type,
    InstalledDevices,
    ActiveDevices30d,
    InteractiveOrSessionDevices30d,
    LastObserved,
    LastInteractiveOrSessionObserved,
    DetectedSoftwareNames,
    ObservedProcesses,
    ObservedRoles
| order by InstalledDevices desc, ActiveDevices30d desc, Product asc
